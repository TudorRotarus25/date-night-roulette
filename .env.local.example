# Neon Postgres (pooled) — used by the app itself, via db/index.ts's local
# proxy override. The port here is cosmetic: that override always routes to
# the neon-proxy container on :4444 regardless of what's written here. In
# production Vercel injects the real Neon value instead (via
# `vercel install neon --plan free`) — don't hand-edit it there.
DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/main

# Neon Postgres (unpooled) — used by `pnpm db:push`/`db:studio`, which talk
# straight to Postgres over plain TCP (see README). Must be the port Postgres
# is actually published on in docker-compose.yml (5433, not 5432 — see the
# comment there). Vercel injects the real Neon value in production.
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@db.localtest.me:5433/main

# The shared passphrase typed at /login
APP_PASSPHRASE=

# Key used to HMAC the passphrase into the auth cookie's value.
# Generate one with: openssl rand -hex 24
AUTH_SECRET=

# Bearer-style token the iOS Shortcut sends as X-Intake-Token
INTAKE_TOKEN=
